#!/usr/bin/env python3
# Stand-in for util-linux flock(1) on machines without it (macOS): `flock [-w SECONDS] LOCKFILE COMMAND...`.
# Real flock(2) advisory lock, so it excludes the Linux flock and itself exactly like the real tool. Tests only.
import fcntl, os, sys, time
a = sys.argv[1:]
wait = None
if a and a[0] == "-w":
    wait, a = float(a[1]), a[2:]
fd = os.open(a[0], os.O_RDWR | os.O_CREAT, 0o644)
end = None if wait is None else time.time() + wait
while True:
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        break
    except OSError:
        if end is not None and time.time() > end:
            sys.exit(1)
        time.sleep(0.02)
os.set_inheritable(fd, True)
os.execvp(a[1], a[1:])
